rule no_admin_port_public {
  let sgs = Resources.*[ Type == 'AWS::EC2::SecurityGroup' ]
  when %sgs !empty {
    %sgs.Properties {
      when SecurityGroupIngress exists {
        SecurityGroupIngress[*] {
          when FromPort == 22 OR ToPort == 22 {
            CidrIp != "0.0.0.0/0"
            CidrIpv6 != "::/0"
          }
          when FromPort == 3389 OR ToPort == 3389 {
            CidrIp != "0.0.0.0/0"
            CidrIpv6 != "::/0"
          }
        }
      }
    }
  }
}
